/target
# the excluded gateway crate (and any nested crate) has its own target dir
target/
**/*.rs.bk
Cargo.lock.orig
.env
# Local Claude Code state (settings, session data) is ignored, but the shared
# audit skills and agents are versioned so the whole team (and a fresh session)
# gets them — see .claude/skills/ and .claude/agents/.
.claude/*
!.claude/skills/
!.claude/agents/

# Node deps for the on-demand admin browser E2E (e2e/admin) — not vendored.
e2e/admin/node_modules/

# oha raw JSON from the production load benchmark
benchmarks/production/results/

# The rendered MkDocs documentation site (build artifact; CI builds and deploys
# it to GitHub Pages — see .github/workflows/pages.yml).
/site/
